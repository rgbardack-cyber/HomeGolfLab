{
  "name": "Badge",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who earned this badge"
    },
    "badge_id": {
      "type": "string",
      "description": "Unique identifier for the badge type"
    },
    "earned_at": {
      "type": "string",
      "format": "date",
      "description": "Date the badge was earned"
    },
    "context": {
      "type": "string",
      "description": "Extra context JSON (e.g. session data that triggered it)"
    }
  },
  "required": [
    "user_email",
    "badge_id",
    "earned_at"
  ]
}