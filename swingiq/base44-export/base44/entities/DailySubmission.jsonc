{
  "name": "DailySubmission",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string",
      "description": "ID of the challenge"
    },
    "entry_id": {
      "type": "string",
      "description": "ID of the challenge entry"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the participant"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Submission date"
    },
    "video_url": {
      "type": "string",
      "description": "URL of the daily video"
    },
    "shots_made": {
      "type": "number",
      "description": "Number of shots made out of 10"
    },
    "points_earned": {
      "type": "number",
      "description": "Points earned for this day"
    },
    "ai_verification": {
      "type": "string",
      "description": "AI analysis of the video"
    }
  },
  "required": [
    "challenge_id",
    "user_email",
    "date"
  ]
}