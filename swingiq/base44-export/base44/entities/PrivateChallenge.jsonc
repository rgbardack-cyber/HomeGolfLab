{
  "name": "PrivateChallenge",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "creator_email": {
      "type": "string"
    },
    "creator_name": {
      "type": "string"
    },
    "participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Invited friend emails"
    },
    "entry_fee": {
      "type": "number"
    },
    "total_pool": {
      "type": "number",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "active",
        "completed"
      ],
      "default": "open"
    },
    "winner_pct": {
      "type": "number",
      "default": 80,
      "description": "Winner gets 80%"
    },
    "app_pct": {
      "type": "number",
      "default": 20,
      "description": "App keeps 20%"
    }
  },
  "required": [
    "title",
    "creator_email",
    "entry_fee"
  ]
}