{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the subscriber"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "monthly",
        "quarterly",
        "semiannual",
        "annual"
      ],
      "default": "free",
      "description": "Subscription plan"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "expired",
        "cancelled"
      ],
      "default": "trial",
      "description": "Subscription status"
    },
    "trial_start_date": {
      "type": "string",
      "format": "date",
      "description": "When the free trial started"
    },
    "trial_end_date": {
      "type": "string",
      "format": "date",
      "description": "When the free trial ends (3 days after start)"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date",
      "description": "When the paid subscription started"
    },
    "subscription_end_date": {
      "type": "string",
      "format": "date",
      "description": "When the current billing period ends"
    },
    "platform": {
      "type": "string",
      "enum": [
        "ios",
        "android",
        "web"
      ],
      "description": "Platform where the subscription was purchased"
    },
    "store_transaction_id": {
      "type": "string",
      "description": "Apple/Google transaction ID for verification"
    },
    "store_product_id": {
      "type": "string",
      "description": "Product ID in App Store / Play Store"
    },
    "price_paid": {
      "type": "number",
      "description": "Amount paid in USD"
    }
  },
  "required": [
    "user_email",
    "plan",
    "status"
  ]
}