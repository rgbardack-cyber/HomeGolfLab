# SwingIQ — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ──────────────────────────────────────────────────────────────────

# Your Anthropic API key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Optional (production) ─────────────────────────────────────────────────────

# Set to "production" to disable FastAPI debug mode
ENVIRONMENT=development

# Port the server listens on (default 8000)
PORT=8000

# Max upload size in MB (default 100)
MAX_UPLOAD_MB=100

# AWS S3 bucket for storing video files (leave blank for local MVP)
# AWS_S3_BUCKET=swingiq-videos
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
