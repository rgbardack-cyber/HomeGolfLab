# SwingIQ Mobile App — Environment Variables
# Copy to .env and set your values.
# Expo exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.

# ── Required: point at your FastAPI backend ───────────────────────────────────

# Local development (iOS Simulator)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Local development (Android Emulator — use this IP instead)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Local development (Physical device — replace with your computer's local IP)
# EXPO_PUBLIC_API_URL=http://192.168.1.XX:8000

# Production (Railway / AWS / etc.)
# EXPO_PUBLIC_API_URL=https://api.swingiq.app
