# Copia este archivo como ".env" y completa los valores. ".env" no se sube a GitHub.

# Servidor (npm run server): clave de la API de Claude para el escaneo de HomeLAB.
ANTHROPIC_API_KEY=

# Orígenes web permitidos en producción, separados por coma (la app nativa y localhost ya están permitidos).
ALLOWED_ORIGINS=

# App: dirección del servidor en producción. Vacío en desarrollo (usa el proxy local).
VITE_API_URL=

# App: unidades de anuncio con recompensa de AdMob. Vacío = anuncios de prueba de Google.
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_REWARDED_IOS=
