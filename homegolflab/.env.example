# Copia este archivo como ".env" y completa los valores. ".env" no se sube a GitHub (.gitignore lo cubre, igual que data/).
# Sin valores aqui: nunca escribas una clave real en este archivo.

# ---------------- Servidor (npm run server) ----------------

# Clave de la API de Claude. La usan DOS rutas: el coach del swing (/api/swing/coach) y el escaneo del Home Lab (/api/homelab/scan).
# La clave de pruebas no va a produccion: produccion lleva otra, en un espacio de trabajo aparte.
ANTHROPIC_API_KEY=

# Alternativa a la clave: un token de autenticacion de Anthropic. El servidor acepta cualquiera de las dos.
ANTHROPIC_AUTH_TOKEN=

# Puerto del servidor. Vacio = 8787.
PORT=

# production = el servidor se niega a arrancar si algo es inseguro (dev-claim encendido, cuota sin verificador de recibos, sin DAILY_TOKEN_BUDGET).
NODE_ENV=

# 1 = el servidor corre detras de un tunel o proxy de confianza (Cloudflare Tunnel): usa la IP real de cf-connecting-ip (o la ultima de
# x-forwarded-for) para el limite por IP. Sin esto usa la IP del socket. NO lo pongas en 1 si el servidor esta expuesto sin tunel.
TRUST_PROXY=

# Tope diario de tokens para TODO el servidor (por dia UTC). Al agotarse, coach y escaneo responden "no disponible por hoy" sin llamar a la API.
# Obligatorio con NODE_ENV=production. El valor lo elige Ryan (el bloque 3 propone uno con numeros medidos). Un reinicio lo vuelve a cero.
DAILY_TOKEN_BUDGET=

# Modelos. Vacio = claude-opus-5-5 en los dos (se elige con la comparacion a ciegas del bloque 3).
COACH_MODEL=
SCAN_MODEL=

# Origenes web permitidos en produccion, separados por coma (la app nativa y localhost ya estan permitidos).
ALLOWED_ORIGINS=

# Planes y cuota mensual del coach (bloque F). Vacio = apagado. Con 1 se enciende; NO encender en produccion
# hasta tener identidad firmada y verificacion de recibos (docs/spec-cuota-coach.md).
ENTITLEMENTS_ENABLED=
# Solo desarrollo: entrega el pase sin recibo. NUNCA en produccion (el servidor no arranca). Exige ENTITLEMENTS_DEV_SECRET.
ENTITLEMENTS_DEV_CLAIM=
# Secreto de al menos 16 caracteres que la ruta dev-claim pide en el encabezado x-hgl-dev-secret. Inventalo tu y no lo subas.
ENTITLEMENTS_DEV_SECRET=
# Ruta del archivo de estado de la cuota. Vacio = data/entitlements.json relativo a donde se arranca el servidor.
ENTITLEMENTS_FILE=
# Cuota mensual de tokens por plan (entero >= 0). Vacio = los valores por defecto de src/lib/plans.ts.
COACH_TOKENS_FREE=
COACH_TOKENS_PREMIUM=
COACH_TOKENS_EARLY_ADOPTER=

# ---------------- App (se leen al compilar con Vite) ----------------

# Direccion del servidor en produccion. Vacio en desarrollo (usa el proxy local). Vacio en produccion = la app funciona sin coach ni escaneo.
VITE_API_URL=

# Carpeta base de la web. GitHub Pages usa /HomeGolfLab/ (lo pasa pages.yml). Vacio = /.
VITE_BASE=

# 1 = ruta con # para alojarla donde no hay servidor que devuelva index.html en cada ruta.
VITE_HASH_ROUTER=

# 1 = build interna: muestra el panel "Funciones de prueba" y "Activar Premium (modo prueba)" en Perfil. NUNCA en un build publico.
VITE_INTERNAL=

# Banderas de funciones (todas apagadas por defecto). 1 o true = encendida. Nombre: VITE_FLAG_ + la bandera en MAYUSCULAS con guiones bajos.
# Banderas: VIDEO_REVIEW, COMPARE, FLIGHT_V2, FLIGHT_ESTIMATE, SHOT_SHAPE_AUTO, DISTANCE_ESTIMATE, EXPORT, EXPORT_GATE, LIVE_RECORDING, CONSENT_FLOW.
# La web publica no enciende ninguna (R2). Para una demostracion, usa una rama aparte.
# Ejemplo (dejalo comentado): VITE_FLAG_VIDEO_REVIEW=1

# Unidades de anuncio con recompensa de AdMob. Vacio = anuncios de prueba de Google.
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_REWARDED_IOS=
